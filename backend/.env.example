# Copy to backend/.env (never commit real keys). Bedrock API keys expire in ≤12h.

# Prefer Bedrock with a short-lived API key (no IAM user/role needed).
VITALIS_USE_BEDROCK=1
AWS_REGION=us-east-2
AWS_BEARER_TOKEN_BEDROCK=replace-with-short-lived-bedrock-api-key

# runtime (default) → AnthropicBedrock / bedrock-runtime
# mantle → AnthropicBedrockMantle / bedrock-mantle
VITALIS_BEDROCK_ENDPOINT=runtime

# Model ids from AWS docs (do not invent others); VITALIS_MODEL stays configurable:
# - bedrock-runtime in us-east-2 is inference-profile-only → us.anthropic.claude-sonnet-4-6
# - foundation / Mantle id → anthropic.claude-sonnet-4-6
# Smoke test tries both when this is empty. Override after smoke reports WORKING_MODEL=...
VITALIS_MODEL=us.anthropic.claude-sonnet-4-6

# Optional Anthropic API instead of Bedrock (leave empty when using Bedrock).
ANTHROPIC_API_KEY=

# SQLite path (optional).
VITALIS_DB=

# Spend controls (Claude Sonnet 4.6 list prices: $3.30 / $16.50 per MTok).
VITALIS_SPEND_CAP_USD=0.50
VITALIS_INPUT_USD_PER_MTOK=3.30
VITALIS_OUTPUT_USD_PER_MTOK=16.50

# ElevenLabs TTS (optional). Leave empty → frontend uses browser speechSynthesis.
# Create voices in the ElevenLabs dashboard; paste real ids here locally — never invent or commit them.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_FR=
ELEVENLABS_MODEL=eleven_flash_v2_5
VITALIS_TTS_CHAR_CAP=3000
