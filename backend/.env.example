# Copy to backend/.env (never commit real keys). Bedrock API keys expire in ≤12h.

# Prefer Bedrock with a short-lived API key (no IAM user/role needed).
VITALIS_USE_BEDROCK=1
AWS_REGION=us-east-2
AWS_BEARER_TOKEN_BEDROCK=replace-with-short-lived-bedrock-api-key

# runtime (default) → AnthropicBedrock / bedrock-runtime
# mantle → AnthropicBedrockMantle / bedrock-mantle
VITALIS_BEDROCK_ENDPOINT=runtime

# Model ids from AWS docs (do not invent others):
# - bedrock-runtime in us-east-2 is inference-profile-only → us.anthropic.claude-haiku-5-5
# - foundation / Mantle id → anthropic.claude-haiku-5-5
# Smoke test tries both when this is empty. Override after smoke reports WORKING_MODEL=...
VITALIS_MODEL=us.anthropic.claude-haiku-5-5

# Optional Anthropic API instead of Bedrock (leave empty when using Bedrock).
ANTHROPIC_API_KEY=

# SQLite path (optional).
VITALIS_DB=

# Spend controls (Haiku 5.5 list prices: $0.10 / $0.50 per MTok).
VITALIS_SPEND_CAP_USD=0.50
VITALIS_INPUT_USD_PER_MTOK=0.10
VITALIS_OUTPUT_USD_PER_MTOK=0.50
